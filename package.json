        "next": "^14.0.0",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "recharts": "^3.0.2",
        "ts-node": "^10.9.2",
        "viem": "^2.33.3",
        "vis-network": "^9.1.13",
